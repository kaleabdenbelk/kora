model UserSettings {
  id              String   @id @default(cuid())
  userId          String   @unique
  dailyReminder   Boolean  @default(true)
  weeklyProgress  Boolean  @default(true)
  streakRanking   Boolean  @default(true)
  appUpdates      Boolean  @default(true)
  telegramOption  Boolean  @default(false)
  emailOption     Boolean  @default(true)
  muteAll         Boolean  @default(false)
  reminderHour    Int      @default(6)
  reminderMinute  Int      @default(30)
  reminderPeriod  Period   @default(AM)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

enum Period {
  AM
  PM
}
